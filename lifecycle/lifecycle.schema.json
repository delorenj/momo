{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://33god.dev/momo/lifecycle.schema.json",
  "title": "Momo ticket-lifecycle spec",
  "description": "Schema for momo/lifecycle/lifecycle.vN.yaml — the one versioned ticket-lifecycle state machine. Provider labels are NOT here (they live in the tp adapter's normalized-state map).",
  "type": "object",
  "additionalProperties": false,
  "required": ["spec_version", "kind", "states", "transitions", "guards"],
  "properties": {
    "spec_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "description": "semver; the filename tracks the major line (lifecycle.vN.yaml)"
    },
    "kind": { "const": "momo.ticket-lifecycle" },
    "schema": { "type": "string", "description": "relative path to this JSON Schema" },
    "states": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["phase"],
        "properties": {
          "phase": {
            "type": "string",
            "enum": ["backlog", "triage", "refining", "ready", "in_progress", "review", "qa", "done", "blocked"]
          },
          "tp_band": {
            "type": "string",
            "enum": ["backlog", "unstarted", "started", "in_review", "completed"],
            "description": "the coarse normalized band the tp adapter maps to a provider column; omitted for `blocked`, which retains the token's prior band"
          },
          "terminal": { "type": "boolean", "default": false },
          "staleness_minutes": { "type": "integer", "minimum": 1 }
        }
      }
    },
    "transitions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["from", "to"],
        "properties": {
          "from": { "type": "string" },
          "to": { "type": "string" },
          "guard": { "type": "string", "description": "named guard predicate evaluated by the driver" },
          "precondition": { "type": "string", "description": "side-effect that must run before the transition (e.g. set_board_review)" },
          "on_fail": { "type": "string", "description": "shared funnel step for failure edges (e.g. blocked_funnel)" }
        }
      }
    },
    "guards": {
      "type": "object",
      "required": ["ac_rubric", "qa", "reviewer_independence", "wip"],
      "properties": {
        "ac_rubric": {
          "type": "object",
          "additionalProperties": false,
          "required": ["require_non_empty", "require_testable_assertions", "require_enumerated_items", "require_fr_coverage", "short_circuit"],
          "properties": {
            "require_non_empty": { "type": "boolean" },
            "require_testable_assertions": { "type": "boolean" },
            "require_enumerated_items": { "type": "boolean" },
            "require_fr_coverage": { "type": "boolean" },
            "short_circuit": { "type": "boolean" }
          }
        },
        "qa": {
          "type": "object",
          "additionalProperties": false,
          "required": ["max_retries"],
          "properties": {
            "max_retries": { "type": "integer", "minimum": 0 },
            "reverify_failed_only": { "type": "boolean" }
          }
        },
        "reviewer_independence": { "type": "boolean" },
        "wip": { "type": "integer", "minimum": 1 }
      }
    },
    "events": {
      "type": "object",
      "properties": {
        "topic_prefix": { "type": "string" },
        "include_project_id": { "type": "boolean" },
        "include_ticket_id": { "type": "boolean" }
      }
    }
  }
}
